# .cogpublic — Public release gate for myrgic/sites
#
# ENFORCED BY: the org-level Public Release Gate workflow
#   (myrgic/.github/.github/workflows/public-release-gate.yml), run in CI on
#   every PR. Locally, from a checkout of myrgic/.github:
#     python3 scripts/cogpublic-guard.py --root /path/to/sites
#
# WHY THIS REPO HAS ONE: this repo is the SOURCE for five public websites
# (myrgic.com/.dev/.ai/.net/.org). Anything that leaks into apps/*/src or
# packages/** is rendered onto live public pages by the cogos SiteProvider.
# A leak here is not "public repo" bad — it is "indexed on the open web" bad.
#
# Baseline dry-run 2026-08-31 with the cogos policy: 39 tracked files scanned,
# 0 hits. This file exists to keep it that way mechanically.

version: 1

content_guards:
  - pattern: "/Users/slowbro"
    description: "Hardcoded operator home directory (macOS)"
  - pattern: "/home/slowbro"
    description: "Hardcoded operator home directory (Linux)"
  - pattern: "-Users-slowbro-"
    description: "Claude project path encoding"
  - pattern: "192404964621025291"
    description: "Personal Discord user snowflake"
  - pattern: 'sk-[a-zA-Z0-9]{20,}'
    description: "OpenAI API key pattern"
  - pattern: 'ghp_[a-zA-Z0-9]{20,}'
    description: "GitHub personal access token"
  - pattern: 'xoxb-[a-zA-Z0-9]+'
    description: "Slack bot token"
  - pattern: '@gmail\.com|@yahoo\.com|@hotmail\.com'
    description: "Personal email address (git author emails exempt)"

# DELIBERATELY NOT GUARDED, verified 2026-08-31 — recorded so the next person
# does not "helpfully" add them:
#
#   "Chaz" / personal names — the repo has an in-flight chaz-profile-page
#     branch: a deliberate, operator-authored public profile. Guarding the
#     name would block intentional public content and force a suppression
#     that takes real findings with it.
#
#   internal hostnames (darkstar, eclipse, *.local) — grepped the tree;
#     zero occurrences today. Guarding names that appear nowhere adds
#     maintenance surface with no signal; add one only with a citation to
#     an actual near-miss.
#
#   http://localhost — legitimate in build/dev docs for a static-site repo;
#     a localhost URL in a README is instructions, not a leak.
#
#   .state.json contents (lineage hex, artifact SHAs) — the file is
#     gitignored (.cog/config/site/.state.json); content guards scan tracked
#     files only, so a pattern here would never fire. The gitignore IS the
#     guard for that file.

# Paths the scan skips. Build output is derived (dist/ is produced by
# apps/*/build.sh and not tracked); vendored/lockfile blobs are not ours to
# sanitize, and scanning them produces noise that trains people to ignore
# the gate.
exclude:
  - node_modules/**
  - "**/node_modules/**"
  - "**/dist/**"
  - package-lock.json
  - "**/package-lock.json"
  - "*.png"
  - "*.jpg"
  - "*.webp"
  - "*.ico"
  - "*.woff"
  - "*.woff2"
